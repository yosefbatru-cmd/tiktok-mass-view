<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B0B"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TIKTOK MASS VIEW"
            android:textColor="#FE2C55"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="High-throughput engine • multi-thread • proxy ready"
            android:textColor="#666666"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VIDEO URL"
            android:textColor="#999999"
            android:textSize="11sp"
            android:letterSpacing="0.05"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/url_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="https://www.tiktok.com/@user/video/..."
            android:textColor="#FFFFFF"
            android:textColorHint="#444444"
            android:background="#1A1A1A"
            android:padding="12dp"
            android:inputType="textUri"
            android:singleLine="true"
            android:layout_marginBottom="14dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TARGET VIEWS"
                    android:textColor="#999999"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/count_input"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="10000"
                    android:textColor="#FFFFFF"
                    android:background="#1A1A1A"
                    android:padding="12dp"
                    android:inputType="number"
                    android:singleLine="true"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="THREADS (4-128)"
                    android:textColor="#999999"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/threads_input"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="32"
                    android:textColor="#FFFFFF"
                    android:background="#1A1A1A"
                    android:padding="12dp"
                    android:inputType="number"
                    android:singleLine="true"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/delay_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delay: 40-120 ms"
            android:textColor="#999999"
            android:textSize="11sp"
            android:layout_marginBottom="4dp"/>

        <SeekBar
            android:id="@+id/delay_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="400"
            android:progress="120"
            android:layout_marginBottom="14dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PROXIES (host:port  or  user:pass@host:port)"
            android:textColor="#999999"
            android:textSize="11sp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/proxy_input"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:hint="1.2.3.4:8080\nuser:pass@5.6.7.8:3128"
            android:textColor="#FFFFFF"
            android:textColorHint="#333333"
            android:background="#1A1A1A"
            android:padding="12dp"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:layout_marginBottom="18dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="18dp">

            <Button
                android:id="@+id/start_btn"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="START ENGINE"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="#FE2C55"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/stop_btn"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="STOP"
                android:textColor="#FFFFFF"
                android:background="#2A2A2A"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/sent_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sent: 0 / 0"
            android:textColor="#FE2C55"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/rps_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 req/s"
                android:textColor="#00E676"
                android:textSize="14sp"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:id="@+id/fail_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fails: 0"
                android:textColor="#FF5252"
                android:textSize="14sp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
