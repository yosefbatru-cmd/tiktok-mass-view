<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B0B"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="mr unknown"
                android:textColor="#C8C8C8"
                android:textSize="16sp"
                android:fontFamily="monospace"/>

            <TextView
                android:id="@+id/status_dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="idle"
                android:textColor="#555555"
                android:textSize="11sp"
                android:fontFamily="monospace"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="url"
            android:textColor="#666666"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/url_input"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="tiktok.com/@.../video/..."
            android:textColor="#DDDDDD"
            android:textColorHint="#333333"
            android:background="#141414"
            android:padding="10dp"
            android:inputType="textUri"
            android:singleLine="true"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="target"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/count_input"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:text="5000"
                    android:textColor="#DDDDDD"
                    android:background="#141414"
                    android:padding="10dp"
                    android:inputType="number"
                    android:singleLine="true"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="threads"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/threads_input"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:text="16"
                    android:textColor="#DDDDDD"
                    android:background="#141414"
                    android:padding="10dp"
                    android:inputType="number"
                    android:singleLine="true"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:gravity="center"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="mode"
            android:textColor="#666666"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/mode_direct_btn"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="direct"
                android:textColor="#111111"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:background="#AAAAAA"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/mode_proxy_btn"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="proxy"
                android:textColor="#888888"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:background="#1A1A1A"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/delay_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="delay  80-200 ms"
            android:textColor="#666666"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="2dp"/>

        <SeekBar
            android:id="@+id/delay_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="400"
            android:progress="140"
            android:layout_marginBottom="12dp"
            android:progressTint="#888888"
            android:thumbTint="#AAAAAA"/>

        <TextView
            android:id="@+id/proxy_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="proxies"
            android:textColor="#666666"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp"
            android:visibility="gone"/>

        <EditText
            android:id="@+id/proxy_input"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:hint="host:port\nuser:pass@host:port"
            android:textColor="#DDDDDD"
            android:textColorHint="#333333"
            android:background="#141414"
            android:padding="10dp"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:layout_marginBottom="12dp"
            android:visibility="gone"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <Button
                android:id="@+id/start_btn"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="start"
                android:textColor="#111111"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:background="#CCCCCC"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/stop_btn"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="stop"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:background="#1A1A1A"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:indeterminateTint="#666666"
            android:visibility="gone"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ready"
            android:textColor="#666666"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/sent_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 / 0"
            android:textColor="#DDDDDD"
            android:textSize="18sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/rps_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0.0 rps"
                android:textColor="#888888"
                android:textSize="12sp"
                android:fontFamily="monospace"/>

            <TextView
                android:id="@+id/fail_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ok 0%"
                android:textColor="#888888"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:gravity="end"/>
        </LinearLayout>

        <TextView
            android:id="@+id/log_console"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="#101010"
            android:padding="8dp"
            android:text=""
            android:textColor="#777777"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:gravity="top"
            android:scrollbars="vertical"/>

    </LinearLayout>
</ScrollView>
