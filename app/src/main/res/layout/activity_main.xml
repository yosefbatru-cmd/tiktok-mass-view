<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080808"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MR UNKNOWN"
            android:textColor="#FE2C55"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="2dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="mass view engine  •  v4"
            android:textColor="#555555"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="22dp"/>

        <!-- URL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VIDEO URL"
            android:textColor="#777777"
            android:textSize="11sp"
            android:letterSpacing="0.06"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/url_input"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="https://www.tiktok.com/@user/video/..."
            android:textColor="#FFFFFF"
            android:textColorHint="#3A3A3A"
            android:background="#141414"
            android:padding="14dp"
            android:inputType="textUri"
            android:singleLine="true"
            android:layout_marginBottom="16dp"/>

        <!-- Target + Threads -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TARGET"
                    android:textColor="#777777"
                    android:textSize="11sp"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/count_input"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="10000"
                    android:textColor="#FFFFFF"
                    android:background="#141414"
                    android:padding="14dp"
                    android:inputType="number"
                    android:singleLine="true"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="THREADS"
                    android:textColor="#777777"
                    android:textSize="11sp"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/threads_input"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="48"
                    android:textColor="#FFFFFF"
                    android:background="#141414"
                    android:padding="14dp"
                    android:inputType="number"
                    android:singleLine="true"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Mode toggle row -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MODE"
            android:textColor="#777777"
            android:textSize="11sp"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/mode_direct_btn"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="DIRECT (no proxy)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:background="#FE2C55"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/mode_proxy_btn"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="PROXY"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:background="#1C1C1C"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <!-- Delay -->
        <TextView
            android:id="@+id/delay_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delay: 30-100 ms"
            android:textColor="#777777"
            android:textSize="11sp"
            android:layout_marginBottom="4dp"/>

        <SeekBar
            android:id="@+id/delay_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="300"
            android:progress="80"
            android:layout_marginBottom="16dp"/>

        <!-- Proxies (shown when proxy mode) -->
        <TextView
            android:id="@+id/proxy_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PROXIES  (host:port  or  user:pass@host:port)"
            android:textColor="#777777"
            android:textSize="11sp"
            android:layout_marginBottom="6dp"
            android:visibility="gone"/>

        <EditText
            android:id="@+id/proxy_input"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:hint="1.2.3.4:8080\nuser:pass@5.6.7.8:3128"
            android:textColor="#FFFFFF"
            android:textColorHint="#2A2A2A"
            android:background="#141414"
            android:padding="12dp"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:layout_marginBottom="18dp"
            android:visibility="gone"/>

        <!-- Start / Stop -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/start_btn"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="START ENGINE"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:background="#FE2C55"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/stop_btn"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="STOP"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:background="#252525"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            android:layout_marginBottom="14dp"/>

        <!-- Live stats card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#111111"
            android:padding="16dp">

            <TextView
                android:id="@+id/status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ready"
                android:textColor="#888888"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/sent_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sent: 0 / 0"
                android:textColor="#FE2C55"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="6dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/rps_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0 req/s"
                    android:textColor="#00E676"
                    android:textSize="14sp"
                    android:layout_marginEnd="20dp"/>

                <TextView
                    android:id="@+id/fail_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fails: 0"
                    android:textColor="#FF5252"
                    android:textSize="14sp"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="runs in background  •  home screen name: Mr Unknown"
            android:textColor="#333333"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"/>

    </LinearLayout>
</ScrollView>
